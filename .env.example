# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# MODEL_MAIN=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# RETRIEVAL_TOP_K=10
# ASSISTANT_NAME=DAISY

# Show the buttons that spend API credit or overwrite data (run the evals, re-fetch sources). Off by default.
# DAISY_STAFF_CONTROLS=1

# DeepEval build loop (tests/evals): no anonymous telemetry
DEEPEVAL_TELEMETRY_OPT_OUT=1
